# Copiar este archivo como .env y completar los valores.

PORT=3003
NODE_ENV=development

# Clave para firmar los tokens JWT (cualquier texto largo y secreto)
JWT_SECRET=cambiar-por-una-clave-secreta

# Opción A: URL completa de Postgres (la que da Render o Neon)
DATABASE_URL=postgres://usuario:password@host:5432/nombre_db

# Opción B (local): en vez de DATABASE_URL, usar variables sueltas
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=expense_manager
# DB_PORT=5432

# Solo producción: URL(s) del frontend en Vercel, separadas por coma (para CORS)
# FRONTEND_URL=https://tu-app.vercel.app

